# Copy to .env and fill in. Real environment variables take precedence over this file.

# Your Nice To Fit You (ntfy.pl) login.
NTFY_EMAIL=you@example.com
NTFY_PASSWORD=change-me

# Optional
# NTFY_BIND=127.0.0.1:8080   # listen address
# NTFY_DB=ntfy.db            # local history archive
# NTFY_READONLY=1            # show your plan but never send changes
# NTFY_DEMO=1                # public menu only, no account needed
