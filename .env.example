# Optional settings; copy to .env to use. Real environment variables take precedence.
# There are no credentials here: you log in on the dashboard's login page, and the
# password is kept in memory only until you log out or the server restarts.

# NTFY_BIND=127.0.0.1:8080        # listen address
# NTFY_DATA_DIR=.                 # where the per-account archives (ntfy-<user id>.db) live
# NTFY_IMAGE_CACHE=cache/images   # dish photo cache
# NTFY_READONLY=1                 # show your plan but never send changes
# NTFY_DEMO=1                     # public menu only, no account needed
