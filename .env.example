# Settings for local runs; copy to .env. Real environment variables take precedence.
# .env is gitignored; on a server, prefer the NixOS module's encrypted credential.

NTFY_EMAIL=you@example.com
NTFY_PASSWORD=change-me
# NTFY_CREDENTIALS_FILE=/path/to/file   # alternative: a file holding email:password

# NTFY_BIND=127.0.0.1:8080        # listen address (there is no login: keep it private)
# NTFY_DATA_DIR=.                 # where the per-account archives (ntfy-<user id>.db) live
# NTFY_IMAGE_CACHE=cache/images   # dish photo cache
# NTFY_READONLY=1                 # show your plan but never send changes
# NTFY_DEMO=1                     # public menu only, no account needed
