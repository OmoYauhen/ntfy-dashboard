# Copy to .env and fill in. Real environment variables take precedence over this file.

# Your Nice To Fit You (ntfy.pl) login.
NFTY_EMAIL=you@example.com
NFTY_PASSWORD=change-me

# Optional
# NFTY_BIND=127.0.0.1:8080   # listen address
# NFTY_DB=nfty.db            # local history archive
# NFTY_READONLY=1            # show your plan but never send changes
# NFTY_DEMO=1                # public menu only, no account needed
